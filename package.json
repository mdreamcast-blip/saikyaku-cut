{
  "name": "reelcaption",
  "productName": "細客CUT",
  "version": "0.1.0",
  "private": true,
  "description": "音声から自動で字幕を起こし、1行ごとに違う演出を付けた縦型リール動画を書き出すデスクトップアプリ",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac --dir",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "test:group": "esbuild scripts/test-group.ts --bundle --platform=node --external:electron --external:@remotion/* --external:ffmpeg-static --external:kuromoji --external:sherpa-onnx-node --outfile=scripts/.t.cjs --log-level=warning && node scripts/.t.cjs",
    "test:render": "esbuild scripts/test-render.ts --bundle --platform=node --external:electron --external:@remotion/* --external:ffmpeg-static --external:kuromoji --external:sherpa-onnx-node --outfile=scripts/.t.cjs --log-level=warning && node scripts/.t.cjs",
    "test:silence": "esbuild scripts/test-silence.ts --bundle --platform=node --external:electron --external:@remotion/* --external:ffmpeg-static --external:kuromoji --external:sherpa-onnx-node --outfile=scripts/.t.cjs --log-level=warning && node scripts/.t.cjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.526",
    "@remotion/captions": "^4.0.526",
    "@remotion/google-fonts": "^4.0.526",
    "@remotion/install-whisper-cpp": "^4.0.526",
    "@remotion/player": "^4.0.526",
    "@remotion/renderer": "^4.0.526",
    "ffmpeg-static": "^5.3.0",
    "kuromoji": "^0.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.526",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "jp.saikyaku-cut.app",
    "productName": "細客CUT",
    "artifactName": "細客CUT-${version}-mac-arm64.${ext}",
    "asar": false,
    "compression": "normal",
    "directories": { "output": "release" },
    "files": [
      "!node_modules/.remotion/**",
      "dist/**",
      "dist-electron/**",
      "src/remotion/**",
      "src/shared/**",
      "package.json",
      "!**/*.map",
      "!node_modules/electron/**",
      "!node_modules/.cache/**",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "extraResources": [
      { "from": "assets/sfx", "to": "sfx" },
      { "from": "resources/whisper", "to": "whisper" }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [{ "target": "dir", "arch": ["arm64"] }],
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0"
    }
  }
}
